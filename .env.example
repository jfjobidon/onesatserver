# Template for .env — copy this file to .env (gitignored) and fill in your own values.
#
# Setup steps:
#   1. cp .env.example .env
#   2. Generate Mongo + Redis passwords (see README "MongoDB Setup" / "Redis Setup").
#   3. Replace every <placeholder> below with the matching value.
#   4. The Docker containers must be created with the SAME credentials (see README).
#
# Never commit .env — it's already in .gitignore.

NODE_ENV="development"

# ─────────────────────────────────────────────────────────────────────────────
# Local Mongo (Docker container osov-mongo-dev, port 27017, replica set rs0).
# Auth is enforced — see README "MongoDB Setup (Docker) > Create the dev container (with auth)".
#   • <mongoUser>     — username created on first container start (e.g. osovAdmin)
#   • <mongoPassword> — generated with `openssl rand -hex 24` (avoid -base64: / + = chars
#                       break URL parsing)
#   • <appName>       — the database name your app uses (this project: onesatonevote)
#   • replicaSet + directConnection — required by Prisma for transactions; directConnection
#                                     skips SRV resolution which is for Atlas only
#   • authSource=admin — the root user lives in the `admin` database, not in <appName>
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="mongodb://<mongoUser>:<mongoPassword>@localhost:27017/<appName>?replicaSet=rs0&directConnection=true&authSource=admin"

# ─────────────────────────────────────────────────────────────────────────────
# Local Redis (Docker container osov-redis-dev, port 6379).
# Password must match the --requirepass value used when the container was created.
#   • <redisPassword> — generated with `openssl rand -hex 24` (hex only, URL-safe)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://default:<redisPassword>@localhost:6379"
